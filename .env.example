# Порт API + WebSocket сервера
PORT=3000
# Адрес веб-клиента (для редиректов OAuth)
WEB_ORIGIN=http://localhost:5173
# Публичный адрес API (для redirect_uri Google OAuth)
API_ORIGIN=http://localhost:3000
# Секрет для JWT (обязательно смените в проде!)
JWT_SECRET=dev-secret-change-me
# Google OAuth: Google Cloud Console -> Credentials -> OAuth 2.0 Client ID
# redirect_uri: <API_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Разрешить тестовый вход без Google: кнопки «Войти (dev)» и «Войти (admin)» (только для локальной разработки)
ALLOW_DEV_LOGIN=true
# Пароль личного аккаунта shlepafloppa (кнопка «Войти как shlepafloppa»); проверяется только на сервере
SHLEPAFLOPPA_PASSWORD=zasq12
# Почты администраторов банка дома (через запятую) — доступ к /admin
ADMIN_EMAILS=
# Стартовый баланс банка дома (задаётся при первом запуске)
HOUSE_START_BALANCE=10000000
# Тайминги фаз игры (секунды)
GAME_BETTING_SECONDS=60
GAME_REVEAL_SECONDS=7
GAME_BID_SECONDS=45
GAME_RESOLVE_SECONDS=8
# Путь к файлу SQLite
DB_PATH=data/auctioneer.db

# --- Боты (самостоятельные ИИ-игроки) ---
# Выключить ботов целиком (например, для отладки): BOTS_ENABLED=false
BOTS_ENABLED=true
# Сколько ботов держать в парке. Расчёт: партия ~4 мин, цель — 4-6 одновременных
# партий и свободный резерв под живых игроков (см. TASKS.md, п. 12.5)
BOT_COUNT=44
# Сколько ботов максимум подсаживается в одно лобби
BOT_PER_LOBBY=3
# Доля парка, которая держится «в комнатах» (остальные на паузе, как люди)
BOT_ROOM_SHARE=0.4
# Сколько полных составов держать свободными под живых игроков (SLA 30 секунд)
BOT_RESERVE_ROOMS=2
# Целевой SLA ожидания лобби, секунды (для логов и метрик)
BOT_LOBBY_SLA_SECONDS=30
# Мета-игра ботов между партиями (торговец, барахолка, сеты, колесо, Санта)
BOT_META_GAME=true
# Болтают ли боты за столом
BOT_CHAT=true
# Подробный лог матчмейкинга ботов
BOT_DEBUG=false
