# Порт API + WebSocket сервера
PORT=3000
# Адрес веб-клиента (для редиректов OAuth)
WEB_ORIGIN=http://localhost:5173
# Публичный адрес API (для redirect_uri Google OAuth)
API_ORIGIN=http://localhost:3000
# Секрет для JWT (обязательно смените в проде!)
JWT_SECRET=dev-secret-change-me
# Google OAuth: Google Cloud Console -> Credentials -> OAuth 2.0 Client ID
# redirect_uri: <API_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Разрешить тестовый вход без Google: кнопки «Войти (dev)» и «Войти (admin)» (только для локальной разработки)
ALLOW_DEV_LOGIN=true
# Почты администраторов банка дома (через запятую) — доступ к /admin
ADMIN_EMAILS=
# Стартовый баланс банка дома (задаётся при первом запуске)
HOUSE_START_BALANCE=10000000
# Тайминги фаз игры (секунды)
GAME_BETTING_SECONDS=60
GAME_REVEAL_SECONDS=7
GAME_BID_SECONDS=25
GAME_RESOLVE_SECONDS=8
# Путь к файлу SQLite
DB_PATH=data/auctioneer.db
